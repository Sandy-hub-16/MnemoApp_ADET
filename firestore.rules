rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// MnemoApp — Firestore Security Rules
//
// Paths covered:
//   public_decks/{deckId}                          — public deck catalogue
//   users/{uid}                                    — user profile documents
//   users/{uid}/decks/{deckId}                     — private deck documents
//   users/{uid}/decks/{deckId}/cards/{cardId}      — cards (private + public)
//   users/{uid}/following/{followeeUid}            — follow graph (outbound)
//   users/{uid}/followers/{followerUid}            — follow graph (inbound)
//   users/{uid}/notifications/{notificationId}     — in-app notifications
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User documents ────────────────────────────────────────────────────
    // Owner has full access.
    // Any authenticated user may read the profile fields (fullName, username,
    // photoUrl) so that PublicProfileScreen can display them.
    match /users/{uid} {
      // Allow public read so unauthenticated users can check username uniqueness during sign-up
      allow read:  if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid;

      // ── Private deck sub-collection ─────────────────────────────────────
      // Owner has full access.
      // Any authenticated user may read deck metadata (title, cardCount,
      // isDraft) so that PublicProfileScreen can compute library stats
      // (deck count, card count) for public profiles. Cards remain private
      // unless the deck is mirrored to public_decks (see cards rule below).
      match /decks/{deckId} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null
                           && request.auth.uid == uid;

        // Cards: owner has full access.
        // Any authenticated user may read (get or list) cards when the parent
        // deck is public — i.e. a mirror doc exists in public_decks/{deckId}.
        // The list permission is required for cloneDeck() which queries the
        // entire cards sub-collection.
        match /cards/{cardId} {
          allow read, write: if request.auth != null
                             && request.auth.uid == uid;

          allow read: if request.auth != null
                      && exists(/databases/$(database)/documents/public_decks/$(deckId));
        }
      }

      // ── Follow graph — outbound (following) ──────────────────────────────
      match /following/{followeeUid} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null
                     && request.auth.uid == uid;
      }

      // ── Follow graph — inbound (followers) ───────────────────────────────
      // Any authenticated user may read the followers sub-collection so that
      // PublicProfileScreen can check follow state and count followers.
      match /followers/{followerUid} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null
                     && request.auth.uid == followerUid;
      }

      // ── In-app notifications ──────────────────────────────────────────────
      // Write is open to any authenticated user so that ShareService can
      // fan-out notification documents into other users' sub-collections.
      match /notifications/{notificationId} {
        allow read: if request.auth != null
                    && request.auth.uid == uid;
        allow write: if request.auth != null;
      }

      // Quiz history and progress aggregates belong only to the signed-in user.
      match /quizAttempts/{attemptId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      match /deckProgress/{progressId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      match /cardProgress/{cardId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      // ── Recent activity sessions ───────────────────────────────────────────
      // User can read and write their own recent sessions.
      match /recentSessions/{deckId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }
    }

    // ── Public deck catalogue ─────────────────────────────────────────────
    match /public_decks/{deckId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUid;

      // Owner can do full updates (title, tag, etc.).
      // Any authenticated user can increment cloneCount (clone operation).
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.ownerUid
                        || (request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['cloneCount'])));

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;
    }

    // ── Deleted-account email cooldown ledger ───────────────────────────────
    // Doc ID is sha256(lowercased email) — never the raw email.
    // Used by AccountDeletionService to: (a) record a 7-day cooldown when an
    // account is deleted, so the email can't immediately be reused for a new
    // signup, and (b) let the registration flow check that cooldown before
    // creating a new account.
    //
    // Reads must stay open to any signed-in OR signed-out client, since the
    // cooldown check runs during sign-up, before the user has an account.
    // Writes are restricted to authenticated users — the client deleting
    // their own account is the only one expected to write here, but since
    // the doc ID is a one-way hash with no way to target an arbitrary
    // other user's email usefully, allowing any authenticated write is an
    // acceptable trade-off here. Tighten further with a Cloud Function if
    // you want this to be server-only.
    match /deletedAccounts/{emailHash} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

  }
}
